# https://git-scm.com/docs/gitignore
# Track the website only. Keep scratch, working, and machine-specific files out.

# Dependencies
/bower_components/
/node_modules/

# Scratch / working artifacts (drafts, notes, extracted docs, backups)
_*.txt
*.draft
*.draft.*
*.tmp
*.bak
*.orig
/scratch/
/tmp/
/notes/
/drafts/
*.docx
*.doc

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Local tooling
.cache/
